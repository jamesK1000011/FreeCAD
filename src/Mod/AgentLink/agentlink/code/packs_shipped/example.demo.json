    "source": "example"
   },
   "applies": {
    "kind": "stair"
   },
   "check": "fact.at_most",
   "params": {
    "fact": "riser_height",
    "max_height_mm": 200
   },
   "tags": [
    "geometry",
    "stairs"
   ]
  },
  {
   "id": "example.stair.tread",
   "title": "A stair's treads at least the limit deep",
   "cite": {
    "source": "example"
   },
   "applies": {
    "kind": "stair"
   },
   "check": "fact.at_least",
   "params": {
    "fact": "tread_depth",
    "min_depth_mm": 250
   },
   "tags": [
    "geometry",
    "stairs"
   ]
  },
  {
   "id": "example.stair.width",
   "title": "A stair at least the limit wide",
   "cite": {
    "source": "example"
   },
   "applies": {
    "kind": "stair"
   },
   "check": "fact.at_least",
   "params": {
    "fact": "width",
    "min_width_mm": 900
   },
   "tags": [
    "geometry",
    "stairs"
   ]
  },
  {
   "id": "example.stair.headroom",
   "title": "Headroom over a stair at least the limit",
   "cite": {
    "source": "example"
   },
   "applies": {
    "kind": "stair"
   },
   "check": "fact.at_least",
   "params": {
    "fact": "headroom",
