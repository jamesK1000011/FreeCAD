{
  "pack": {
    "id": "example.demo",
    "title": "Example pack: shows the format, not any real code",
    "layer": "model",
    "jurisdiction": "XX",
    "version": "0.2.0",
    "effective": "2000-01-01",
    "license": "CC0-1.0",
    "note": "Made-up numbers in the shape a real pack takes. Jurisdiction XX matches no real place: set a project to XX to try the engine. Real packs carry paraphrased rules with citations and are added by the person (code_packs import)."
  },
  "values": {
    "load.live.floor": {
      "value": 1.9,
      "unit": "kPa",
      "stricter": "higher"
    },
    "load.dead.floor": {
      "value": 0.5,
      "unit": "kPa",
      "stricter": "higher"
    },
    "load.live.attic_storage": {
      "value": 1.0,
      "unit": "kPa",
      "stricter": "higher"
    },
    "load.dead.attic_storage": {
      "value": 0.5,
      "unit": "kPa",
      "stricter": "higher"
    },
    "load.live.habitable_attic": {
      "value": 1.4,
      "unit": "kPa",
      "stricter": "higher"
    },
    "load.dead.habitable_attic": {
      "value": 0.5,
      "unit": "kPa",
      "stricter": "higher"
    },
    "load.dead.roof": {
      "value": 0.7,
      "unit": "kPa",
      "stricter": "higher"
    },
    "load.snow.ground": {
      "value": 1.2,
      "unit": "kPa",
